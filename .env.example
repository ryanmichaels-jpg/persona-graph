# Persona Graph — environment variables
# Copy to .env and fill in. Never commit .env.

# --- LLM ---
# Used for content tagging (Haiku 4.5, batched) + ICP scoring.
ANTHROPIC_API_KEY=sk-ant-...

# --- Scrapers (optional — only needed if you re-run live scrapes) ---
# Apify CLI uses ~$3 per fresh scrape across 10 sources. Free $5/mo credit
# usually covers one initial scrape. Synthetic seed is committed so the
# demo works without an Apify account.
APIFY_API_TOKEN=

# --- Local / runtime ---
# Set to "1" to use the synthetic seeded SQLite + heuristic tagger (no LLM
# calls). Default demo path. Set to 0 + provide ANTHROPIC_API_KEY for live tagging.
DRY_RUN=1

# Path to the SQLite intel DB (default is the committed seed in data/)
INTEL_DB_PATH=data/intel.db

# Persona currently being graphed (used for ICP scoring weights)
TARGET_PERSONA=gtm_engineer
